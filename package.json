{
  "name": "inventory-orders-api",
  "version": "1.0.0",
  "description": "Inventory and Orders REST API (SonarQube training sample)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
